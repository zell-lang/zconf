namespace zconf

// EnvSource reads environment variables that start with Prefix. The
// prefix is removed and "__" becomes the level separator, so
// APP_SERVERS__0__HOST=a sets "servers:0:host". With Vars == nil the
// process environment is read; tests pass "KEY=value" lines instead.
struct EnvSource {
    Prefix string
    Vars   []string

    func Load() map[string]string! {
        var vars = this.Vars
        if vars == nil {
            vars = Environ()
        }
        var out = map[string]string{}
        for line in vars {
            var i = strings.Index(line, "=")
            if i <= 0 {
                continue
            }
            var key = envKey(line[..i], this.Prefix)
            if key != "" {
                out[key] = line[i + 1..]
            }
        }
        return out
    }

    func Name() string {
        return "environment " + this.Prefix + "*"
    }
}

// Environ returns the process environment as "KEY=value" lines.
//
// The Zell standard library has no os.Environ yet, so this reads
// /proc/self/environ (Linux); elsewhere it returns no variables.
func Environ() []string {
    var raw = try io.ReadFile("/proc/self/environ") else ""
    var out []string = []
    for line in strings.Split(raw, "\0") {
        if line != "" {
            out = append(out, line)
        }
    }
    return out
}

// envKey maps a variable name to a config key: strip the prefix (case-
// insensitively), "__" -> ":", lower-case. "" when the prefix does not match.
func envKey(name string, prefix string) string {
    if prefix != "" {
        if len(name) <= len(prefix) || !strings.EqualFold(name[..len(prefix)], prefix) {
            return ""
        }
        name = name[len(prefix)..]
    }
    return NormalizeKey(strings.Replace(name, "__", Separator))
}

// ParseDotEnv reads .env text: KEY=value lines, an optional "export "
// prefix, "#" comments, double quotes with \n \t \" \\ escapes, literal
// single quotes. Keys are mapped like EnvSource (prefix, "__").
func ParseDotEnv(text string, prefix string) map[string]string! {
    var out = map[string]string{}
    for n, raw in strings.Split(text, "\n") {
        var line = strings.Trim(raw)
        if line == "" || strings.HasPrefix(line, "#") {
            continue
        }
        line = strings.Trim(strings.TrimPrefix(line, "export "))
        var i = strings.Index(line, "=")
        if i <= 0 {
            return error(fmt.Format("line {0}: expected KEY=value", n + 1))
        }
        var key = envKey(strings.Trim(line[..i]), prefix)
        var value = dotEnvValue(strings.Trim(line[i + 1..]))?(fmt.Format("line {0}", n + 1))
        if key != "" {
            out[key] = value
        }
    }
    return out
}

func dotEnvValue(v string) string! {
    if strings.HasPrefix(v, "'") {
        var end = strings.Index(v[1..], "'")
        if end < 0 {
            return error("unterminated single quote")
        }
        return v[1..end + 1]
    }
    if strings.HasPrefix(v, "\"") {
        var b = strings.Builder{}
        var escaped = false
        for c in v[1..] {
            if escaped {
                switch c {
                    case 'n': b.Write("\n")
                    case 't': b.Write("\t")
                    default:
                        b.Write(string(c))
                }
                escaped = false
            } else if c == '\\' {
                escaped = true
            } else if c == '"' {
                return b.String()
            } else {
                b.Write(string(c))
            }
        }
        return error("unterminated double quote")
    }
    var hash = strings.Index(v, " #")
    if hash >= 0 {
        v = strings.Trim(v[..hash])
    }
    return v
}
